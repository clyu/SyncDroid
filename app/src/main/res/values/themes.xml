<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 15 on the system bars are transparent and show the window behind them.
         Before that they have a colour of their own, which is made transparent to match. -->
    <style name="Theme.SyncDroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
