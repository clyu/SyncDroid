<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The activity draws behind the system bars and pads its content itself. Before Android 15
         the bars still have a colour of their own, hence the transparent ones. -->
    <style name="Theme.SyncDroid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
